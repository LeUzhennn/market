{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // 自動命名：資料夾名稱_dev
  "runArgs": [
    "--name", "${localWorkspaceFolderBasename}_dev"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  // 啟動後自動安裝專案套件
  // 注意：Ubuntu 24.04 需加上 --break-system-packages 才能直接安裝全域套件
  "postCreateCommand": "if [ -f requirements.txt ]; then pip install -r requirements.txt --break-system-packages; fi",
  "remoteUser": "vscode"
}